{
  "manifest_version": 3,
  "name": "SpeedGrader Student Search",
  "version": "1.0.0",
  "description": "Type a name, jump straight to that student in Canvas SpeedGrader.",
  "content_scripts": [
    {
      "matches": ["https://*.instructure.com/courses/*/gradebook/speed_grader*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
